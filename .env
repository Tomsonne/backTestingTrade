# Twelve Data — créer une clé gratuite depuis le dashboard Twelve Data.
# Ne jamais mettre cette clé dans du JavaScript côté navigateur.
TWELVE_DATA_API_KEY=a015d05c193348a4b00ab68df60363f9
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# Basic gratuit: 8 crédits/minute et 800/jour actuellement.
TWELVE_DATA_CREDITS_PER_MINUTE=8
# M1: 3 jours = 4320 points théoriques, sous la limite de 5000/réponse.
TWELVE_DATA_CHUNK_DAYS=3

BACKTEST_START=2026-02-01
SESSION_TIMEZONE=Europe/Paris
SESSIONS_JSON=[{"name":"ASIA","start":"23:00","end":"06:00"},{"name":"BLUE","start":"07:00","end":"11:00"},{"name":"RED","start":"12:00","end":"16:00"}]

IMBALANCE_MIN_ADR_PCT=0.50
ADR_LENGTH=15
ZONE_DIRECTION_MATCH=true
M1_LEFT_BARS=5
M1_RIGHT_BARS=5
M1_MIN_DIVERGENCES=1
M1_CHECK_CUT_THROUGH=true
INVALIDATE_IF_DXY_CONFIRMS=true

EURUSD_SL_PIPS=15
EURUSD_TP_PIPS=30
GBPUSD_SL_PIPS=20
GBPUSD_TP_PIPS=40

# Twelve Data /time_series n'a pas de bid/ask historique. Laisser à 0 pour
# un test brut, puis renseigner un spread moyen si on veut une simulation plus sévère.
EURUSD_SPREAD_PIPS=0
GBPUSD_SPREAD_PIPS=0

FIRST_TRADE_RISK_PCT=2
SECOND_TRADE_RISK_PCT=1
STARTING_EQUITY=10000
SAME_BAR_POLICY=stop_first
MAX_HOLD_MINUTES=1440

ENABLE_SCHEDULER=true
AUTO_RUN_ON_STARTUP=true
SCHEDULE_MINUTE=7
DATA_DIR=./data
DB_PATH=./data/riseup.sqlite3
