# Historical provider recommended for reproducible research. No API key needed.
DATA_PROVIDER=dukascopy
DUKASCOPY_BASE_URL=https://jetta.dukascopy.com/v1
DUKASCOPY_WORKERS=4
DATA_VALIDATION_MODE=strict

# Direct verified instrument: DOLLAR.IDX-USD. Use synthetic to retain the ICE fallback.
DXY_SOURCE=dukascopy_direct
EXECUTION_PRICE_MODE=bid_ask
# Preserve the legacy strategy until volume-dependent labels are explicitly compared.
VOLUME_MODE=legacy_no_volume

# Twelve Data migration fallback only. Keep the example value empty.
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
TWELVE_DATA_CREDITS_PER_MINUTE=8
TWELVE_DATA_CHUNK_DAYS=3

BACKTEST_START=2024-01-01
# Empty means the latest completed M1 candle. Set an explicit end for exact reruns.
BACKTEST_END=
SESSION_TIMEZONE=Europe/Paris
# H2/H4 remain anchored to strategy-local midnight unless deliberately changed.
HTF_ANCHOR_TIMEZONE=Europe/Paris
SESSIONS_JSON=[{"name":"ASIA","start":"23:00","end":"06:00"},{"name":"BLUE","start":"07:00","end":"11:00"},{"name":"RED","start":"12:00","end":"16:00"}]

IMBALANCE_MIN_ADR_PCT=0.50
ADR_LENGTH=15
ZONE_DIRECTION_MATCH=true
M1_LEFT_BARS=5
M1_RIGHT_BARS=5
M1_MIN_DIVERGENCES=1
M1_CHECK_CUT_THROUGH=true
INVALIDATE_IF_DXY_CONFIRMS=true

EURUSD_SL_PIPS=15
EURUSD_TP_PIPS=30
GBPUSD_SL_PIPS=20
GBPUSD_TP_PIPS=40

# Used only by legacy mid execution when historical bid/ask is unavailable.
EURUSD_SPREAD_PIPS=0
GBPUSD_SPREAD_PIPS=0

FIRST_TRADE_RISK_PCT=2
SECOND_TRADE_RISK_PCT=1
STARTING_EQUITY=10000
SAME_BAR_POLICY=stop_first
MAX_HOLD_MINUTES=1440

ENABLE_SCHEDULER=true
AUTO_RUN_ON_STARTUP=false
SCHEDULE_MINUTE=7
DATA_DIR=./data
DB_PATH=./data/riseup.sqlite3
